# Copy to deploy/.env (same directory as docker-compose.yml) and fill in real values.
# Never commit the filled-in file — it holds credentials.

# Postgres superuser password for the ledgerlens database (required).
POSTGRES_PASSWORD=change-me-strong

# Advisor model pulled into the Ollama container on first start.
OLLAMA_MODEL=qwen2.5:3b

# Host port for the app (defaults to 8083; change if the port is taken).
APP_PORT=8083
